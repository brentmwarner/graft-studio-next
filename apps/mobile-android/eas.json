{
  "cli": {
    "version": ">= 16.0.1"
  },
  "build": {
    "development": {
      "android": {
        "buildType": "apk"
      },
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "developmentClient": false,
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    }
  }
}
