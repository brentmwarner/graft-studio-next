{
  "cli": {
    "version": ">= 16.0.1"
  },
  "build": {
    "development": {
      "android": {
        "buildType": "apk"
      },
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "bun": "1.4.2",
      "developmentClient": false,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "node": "24.13.1"
    },
    "production": {
      "autoIncrement": true
    }
  }
}
