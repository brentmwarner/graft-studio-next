{
  "expo": {
    "name": "Graft",
    "slug": "graft-mobile-android",
    "scheme": "graft",
    "version": "0.1.0",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "studio.graft.mobile.expo",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Graft to scan a pairing QR code or take a photo to attach.",
        "NSPhotoLibraryUsageDescription": "Allow Graft to attach photos from your library.",
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "package": "studio.graft.mobile",
      "predictiveBackGestureEnabled": false,
      "permissions": ["CAMERA"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Graft to scan a pairing QR code or take a photo to attach.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Graft to attach photos from your library.",
          "cameraPermission": "Allow Graft to take a photo to attach to a message."
        }
      ],
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "ios": {
            "image": "./assets/icon.png"
          },
          "android": {
            "image": "./assets/adaptive-icon.png",
            "imageWidth": 192
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "26.0"
          },
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-web-browser",
      "expo-asset",
      "./plugins/withIosSceneLifecycle.js"
    ],
    "extra": {
      "eas": {
        "projectId": "493cee18-fb3c-4e70-8c69-9d9fa903e962"
      }
    },
    "owner": "brentmwarner"
  }
}
